# ==============================================================================
# Zero-Trust Architecture Enterprise Lab — Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=4000
USE_HTTPS=false

# Cryptographic Token Keys (MUST be at least 32 characters long)
JWT_ACCESS_SECRET=zt_access_secret_super_secure_key_32_chars_min!
JWT_REFRESH_SECRET=zt_refresh_secret_super_secure_key_32_chars_min!

# AES-256-GCM Data-at-Rest Encryption Key (32-byte hex or 32-char string)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Persistent State Stores (Configured for Docker Compose & Localhost)
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://zerotrust_user:SecurePostgresPass2026!@127.0.0.1:5432/zerotrust_db

# Security Thresholds
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
